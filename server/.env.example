# Server
PORT=5000

# MongoDB — get from your provider (MongoDB Atlas, mLab, etc.)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db_name>?retryWrites=true&w=majority
DB_NAME=wishmap

# JWT — generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change_me_to_a_random_string

# CORS — comma-separated list of allowed origins (use * for development)
CORS_ORIGIN=http://localhost:5173,https://your-app-domain.vercel.app

# Public URL of this API (used by Swagger and CORS). On Render you can leave it
# empty and the app will use RENDER_EXTERNAL_URL automatically.
BASE_URL=https://your-api-domain.onrender.com
